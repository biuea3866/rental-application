{
  "title": "MongoDB 모니터링",
  "uid": "rental-mongodb",
  "tags": ["rental", "mongodb"],
  "timezone": "browser",
  "refresh": "30s",
  "schemaVersion": 38,
  "version": 1,
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "MongoDB 작업 처리량 (ops/초)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1000 },
              { "color": "red", "value": 5000 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "rate(mongodb_op_counters_total{type=\"query\"}[5m])",
          "legendFormat": "Query/sec",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "rate(mongodb_op_counters_total{type=\"insert\"}[5m])",
          "legendFormat": "Insert/sec",
          "refId": "B"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "rate(mongodb_op_counters_total{type=\"update\"}[5m])",
          "legendFormat": "Update/sec",
          "refId": "C"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "rate(mongodb_op_counters_total{type=\"delete\"}[5m])",
          "legendFormat": "Delete/sec",
          "refId": "D"
        }
      ]
    },
    {
      "id": 2,
      "title": "MongoDB 커넥션",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 500 },
              { "color": "red", "value": 1000 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "mongodb_connections{state=\"current\"}",
          "legendFormat": "Current Connections",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "mongodb_connections{state=\"available\"}",
          "legendFormat": "Available Connections",
          "refId": "B"
        }
      ]
    },
    {
      "id": 3,
      "title": "MongoDB 복제 지연 (Replication Lag)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 5 },
              { "color": "red", "value": 30 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "mongodb_mongod_replset_member_replication_lag",
          "legendFormat": "Replication Lag ({{member_state}})",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "WiredTiger 캐시 사용률",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "mongodb_mongod_wiredtiger_cache_bytes{type=\"total\"}",
          "legendFormat": "Cache Total",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "mongodb_mongod_wiredtiger_cache_bytes{type=\"used\"}",
          "legendFormat": "Cache Used",
          "refId": "B"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "mongodb_mongod_wiredtiger_cache_bytes{type=\"dirty\"}",
          "legendFormat": "Cache Dirty",
          "refId": "C"
        }
      ]
    },
    {
      "id": 5,
      "title": "MongoDB 메모리 사용",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "mongodb_memory{type=\"resident\"} * 1024 * 1024",
          "legendFormat": "Resident Memory",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "mongodb_memory{type=\"virtual\"} * 1024 * 1024",
          "legendFormat": "Virtual Memory",
          "refId": "B"
        }
      ]
    },
    {
      "id": 6,
      "title": "MongoDB 문서 작업 통계",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "rate(mongodb_mongod_metrics_document_total{state=\"inserted\"}[5m])",
          "legendFormat": "Documents Inserted/sec",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "rate(mongodb_mongod_metrics_document_total{state=\"updated\"}[5m])",
          "legendFormat": "Documents Updated/sec",
          "refId": "B"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "rate(mongodb_mongod_metrics_document_total{state=\"deleted\"}[5m])",
          "legendFormat": "Documents Deleted/sec",
          "refId": "C"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "rate(mongodb_mongod_metrics_document_total{state=\"returned\"}[5m])",
          "legendFormat": "Documents Returned/sec",
          "refId": "D"
        }
      ]
    },
    {
      "id": 7,
      "title": "MongoDB 네트워크 I/O",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "rate(mongodb_network_bytes_total{state=\"in_bytes\"}[5m])",
          "legendFormat": "Network In/sec",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "rate(mongodb_network_bytes_total{state=\"out_bytes\"}[5m])",
          "legendFormat": "Network Out/sec",
          "refId": "B"
        }
      ]
    },
    {
      "id": 8,
      "title": "MongoDB ReplicaSet 멤버 상태",
      "type": "stat",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null }
            ]
          },
          "mappings": [
            { "options": { "1": { "text": "PRIMARY" }, "2": { "text": "SECONDARY" }, "6": { "text": "UNKNOWN" }, "8": { "text": "DOWN" } }, "type": "value" }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "mongodb_mongod_replset_my_state",
          "legendFormat": "My State",
          "refId": "A"
        }
      ]
    }
  ]
}
